SERVICE_DATABASE_URL=postgresql+psycopg://scheduling:local-demo-only@localhost:55412/telelink
# Dedicated local test Redis; normal Compose Redis uses localhost:6379.
SERVICE_REDIS_URL=redis://127.0.0.1:56379/0
SERVICE_REDIS_TIMEOUT_SECONDS=0.3
# API runtime; replace pool/client with the current Floci bootstrap values.
SERVICE_ENVIRONMENT=local
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8003
SERVICE_ROOT_PATH=/api/v1/scheduling
SERVICE_AUTH_ISSUER=http://localhost:4566/replace-with-pool-id
SERVICE_AUTH_JWKS_URL=http://localhost:4566/replace-with-pool-id/.well-known/jwks.json
SERVICE_AUTH_CLIENT_ID=replace-with-client-id
SERVICE_AUTH_REQUIRED_SCOPES=openid
SERVICE_IDENTITY_URL=http://127.0.0.1:8001
SERVICE_TENANT_URL=http://127.0.0.1:8002
# Share the scheduling key with tenant's SERVICE_SCHEDULING_SECRET.
# Synthetic examples only. Use separate random keys of at least 32 bytes.
SERVICE_SCHEDULING_SECRET=local-s02-booking-key-at-least-32-bytes
SERVICE_CURSOR_SECRET=local-s02-cursor-key-at-least-32-bytes
SERVICE_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
