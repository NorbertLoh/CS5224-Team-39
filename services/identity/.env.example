# API reads .env; export SERVICE_DATABASE_URL separately for Alembic.
SERVICE_DATABASE_URL=postgresql+psycopg://identity:local-demo-only@127.0.0.1:55408/telelink
SERVICE_ENVIRONMENT=local
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8001
# Direct service paths are /me and /clinics/...; proxy strips /api/v1/identity.
SERVICE_ROOT_PATH=
# Replace with values from the local Cognito bootstrap. Configure all three.
# SERVICE_AUTH_ISSUER=http://localhost:4566/ACTUAL_POOL_ID
# SERVICE_AUTH_JWKS_URL=http://localhost:4566/ACTUAL_POOL_ID/.well-known/jwks.json
# SERVICE_AUTH_CLIENT_ID=ACTUAL_PUBLIC_CLIENT_ID
SERVICE_AUTH_REQUIRED_SCOPES=openid
# Generate two DIFFERENT random secrets, each at least 32 bytes; keep out of Git.
# SERVICE_CURSOR_SECRET=REPLACE_WITH_RANDOM_SECRET
# SERVICE_SCHEDULING_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET
# A08: match the tenant service's key; distinct from cursor/scheduling keys.
# SERVICE_TENANT_SECRET=REPLACE_WITH_RANDOM_TENANT_SECRET
# Empty by default: no service action is enabled without explicit configuration.
SERVICE_SCHEDULING_ACTIONS=
# Explicit local-only adapter for known F14 clinic IDs; not a live tenant API.
# SERVICE_CLINIC_FIXTURE_PATH=../../dev/fixtures/telelink.json
# JSON array of exact browser origins; empty means no cross-origin browser access.
SERVICE_CORS_ORIGINS=[]
