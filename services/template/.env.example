SERVICE_NAME=template
SERVICE_ENVIRONMENT=local
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8000
SERVICE_LOG_LEVEL=INFO
# Docs default to enabled locally and disabled in production.
# SERVICE_DOCS_ENABLED=false
# Set when an upstream proxy removes a path prefix; endpoints remain /health/*.
SERVICE_ROOT_PATH=
# Optional PostgreSQL example; provision schema and run migrations first.
# Percent-encode special characters in the username/password.
# SERVICE_DATABASE_URL=postgresql+psycopg://template:local-demo-only@localhost:55404/telelink
SERVICE_DATABASE_TIMEOUT_SECONDS=3
