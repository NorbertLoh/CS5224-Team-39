# Synthetic LOCAL configuration only. Export explicitly before running Alembic.
SERVICE_DATABASE_URL=postgresql+psycopg://billing:local-demo-only@127.0.0.1:55414/telelink
# Reset-enabled tests must use a separate disposable database.
# TEST_DATABASE_URL=postgresql+psycopg://billing:local-demo-only@127.0.0.1:55414/telelink
# BILLING_TEST_ALLOW_RESET=1

# B02 API and required expiry worker. Service-local paths; ingress strips /api/v1/<service>.
SERVICE_PORT=8009
SERVICE_ROOT_PATH=/api/v1/billing
SERVICE_AUTH_ISSUER=http://localhost:4566/ap-southeast-1_LOCAL
SERVICE_AUTH_JWKS_URL=http://localhost:4566/ap-southeast-1_LOCAL/.well-known/jwks.json
SERVICE_AUTH_CLIENT_ID=replace-with-local-spa-client
SERVICE_IDENTITY_URL=http://localhost:8001
# B05 signed pagination cursors; use an independent random secret outside local/test.
SERVICE_CURSOR_SECRET=local-b05-pagination-only-at-least-32-bytes
SERVICE_SCHEDULING_URL=http://localhost:8003
# Match scheduling's SERVICE_BILLING_SECRET; scheduling also needs SERVICE_BILLING_URL.
SERVICE_SCHEDULING_SECRET=local-b02-scheduling-only-at-least-32-bytes
SERVICE_TENANT_URL=http://localhost:8002
# Match tenant's new SERVICE_BILLING_SECRET; keep distinct from the scheduling key.
SERVICE_TENANT_SECRET=local-b02-tenant-only-at-least-32-bytes
# B06 trusted order/quote reservation. Real fulfilment implementation is pending;
# see MEDICATION_CHECKOUT.md before enabling checkout against a fixture.
SERVICE_FULFILMENT_URL=http://localhost:8006
# Match fulfilment's billing credential; keep distinct from scheduling/tenant keys.
SERVICE_FULFILMENT_SECRET=local-b06-fulfilment-only-at-least-32-bytes
SERVICE_STRIPE_DESTINATIONS={"40000000-0000-4000-8000-000000000001":"acct_replace"}
# Set SERVICE_STRIPE_SECRET_KEY to an sk_test_ key through the environment or local .env.
# This is separate from the unprefixed X03 spike variables below. Live keys are refused.
SERVICE_CHECKOUT_SUCCESS_URL=http://localhost:5173/payments/return
SERVICE_CHECKOUT_CANCEL_URL=http://localhost:5173/appointments
SERVICE_CORS_ORIGINS=["http://localhost:5173"]

# B03 billing API receiver: POST /webhooks/stripe (service-local path).
# Set SERVICE_STRIPE_WEBHOOK_SECRET to the whsec_ signing secret for THIS endpoint.
# Independent from SERVICE_STRIPE_SECRET_KEY and the unprefixed X04 spike setting.
# SERVICE_STRIPE_WEBHOOK_SECRET=whsec_replace_with_endpoint_secret

# B04 publisher (run separately from app.payment_worker processing mode).
SERVICE_EVENT_BUS_NAME=telelink-local
SERVICE_AWS_REGION=ap-southeast-1
SERVICE_AWS_ENDPOINT_URL=http://localhost:4566
# Local emulator only: export AWS_ACCESS_KEY_ID=test and AWS_SECRET_ACCESS_KEY=test.
# AWS deployments omit the endpoint override and use task-role credentials.

# X03 isolated test-mode spike; never use a live key.
# The spike loads only these two names from services/billing/.env by default.
STRIPE_SECRET_KEY=
STRIPE_CONNECTED_ACCOUNT_ID=

# X04: endpoint signing secret from `stripe listen`, distinct from the API key.
# Leave blank for synthetic --demo mode. CLI and Dashboard secrets are different.
STRIPE_WEBHOOK_SECRET=
