# TEST_DATABASE_URL=postgresql+psycopg://billing:local-demo-only@127.0.0.1:55414/telelink
# BILLING_TEST_ALLOW_RESET=1

# X03 isolated test-mode spike; never use a live key.
# The spike loads only these two names from services/billing/.env by default.
STRIPE_SECRET_KEY=
STRIPE_CONNECTED_ACCOUNT_ID=
