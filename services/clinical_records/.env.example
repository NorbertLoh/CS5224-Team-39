SERVICE_DATABASE_URL=postgresql+psycopg://clinical_records:local-demo-only@127.0.0.1:55431/telelink
SERVICE_ENVIRONMENT=local
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8005
# Routes already include /api/v1/clinical-records. Leave root_path empty locally.
SERVICE_AUTH_ISSUER=http://localhost:4566/replace-with-pool-id
SERVICE_AUTH_JWKS_URL=http://localhost:4566/replace-with-pool-id/.well-known/jwks.json
SERVICE_AUTH_CLIENT_ID=replace-with-client-id
SERVICE_AUTH_REQUIRED_SCOPES=openid
# Base URLs include any ingress API prefix; direct local services use none.
SERVICE_IDENTITY_URL=http://127.0.0.1:8001
SERVICE_SCHEDULING_URL=http://127.0.0.1:8003
SERVICE_FULFILMENT_URL=http://127.0.0.1:8006
SERVICE_TENANT_URL=http://127.0.0.1:8002
# Independent random 32+ byte keys, matching the named peer setting.
# SERVICE_DOCUMENT_SECRET=          # document SERVICE_RECORDS_SECRET
# SERVICE_IDENTITY_DOCUMENT_SECRET= # identity SERVICE_RECORDS_SECRET
# SERVICE_TENANT_DOCUMENT_SECRET=   # tenant SERVICE_RECORDS_SECRET
# D07 minimum audited dispensing reads; match fulfilment SERVICE_RECORDS_SECRET.
# SERVICE_FULFILMENT_SECRET=replace-with-independent-random-secret-at-least-32-bytes
# Required MC completion callback; match consultation SERVICE_RECORDS_SECRET.
# SERVICE_CONSULTATION_SECRET=replace-with-independent-random-secret-at-least-32-bytes
SERVICE_UPSTREAM_TIMEOUT_SECONDS=3
# Synthetic local key only; use an independent random secret in deployed environments.
SERVICE_CURSOR_SECRET=local-r02-cursor-key-with-at-least-32-bytes
# Separate publisher process; SDK credentials come from its environment/task role.
SERVICE_AWS_REGION=ap-southeast-1
SERVICE_EVENT_BUS_NAME=telelink-local
# Local Floci only; omit for AWS deployments.
SERVICE_AWS_ENDPOINT_URL=http://localhost:4566
