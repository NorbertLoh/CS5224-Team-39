# Match consultation SERVICE_SIGNALLING_SECRET. Use a random key >=32 bytes.
SIGNALLING_SECRET=
# Containers reach the consultation API on the host. Configure SERVICE_HOST so
# it is reachable from Docker; protect service ports from external networks.
CONSULTATION_URL=http://host.docker.internal:8004
CONSULTATION_UPSTREAM=host.docker.internal:8004
# Direct Node runtime (outside Compose) reads these optional settings:
SIGNALLING_ENVIRONMENT=local
SIGNALLING_HOST=127.0.0.1
SIGNALLING_PORT=9000
SIGNALLING_ORIGINS=https://localhost:8443
