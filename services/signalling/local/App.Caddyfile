{
    auto_https disable_redirects
    log {
        output discard
    }
}

https://localhost:8443 {
    tls internal
    header Cache-Control "no-store"
    header Referrer-Policy "no-referrer"
    header X-Content-Type-Options "nosniff"
    handle /peerjs/* {
        reverse_proxy signalling:9000
    }
    # Vite routes public API paths and blocks service-internal paths.
    handle {
        reverse_proxy {$WEB_UPSTREAM:host.docker.internal:5173}
    }
}
