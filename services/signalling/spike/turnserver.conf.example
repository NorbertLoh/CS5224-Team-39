# Copy to .local/turnserver.conf; replace ALL CHANGE_ME values before starting.
listening-port=3478
tls-listening-port=5349
min-port=49160
max-port=49179
fingerprint
realm=x01.telelink.invalid
server-name=x01.telelink.invalid
use-auth-secret
static-auth-secret=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
# Set the public address. Behind 1:1 NAT, use PUBLIC_IP/PRIVATE_IP instead.
external-ip=CHANGE_ME_PUBLIC_IP
cert=/etc/coturn/tls/fullchain.pem
pkey=/etc/coturn/tls/privkey.pem
no-dtls
no-tlsv1
no-tlsv1_1
no-cli
no-multicast-peers
no-tcp-relay
stale-nonce=600
max-allocate-lifetime=600
user-quota=4
total-quota=20
# Bytes per second per session, enough for a prototype video call.
max-bps=1000000
denied-peer-ip=0.0.0.0-0.255.255.255
denied-peer-ip=10.0.0.0-10.255.255.255
denied-peer-ip=127.0.0.0-127.255.255.255
denied-peer-ip=169.254.0.0-169.254.255.255
denied-peer-ip=172.16.0.0-172.31.255.255
denied-peer-ip=192.168.0.0-192.168.255.255
denied-peer-ip=::1
denied-peer-ip=fc00::-fdff:ffff:ffff:ffff:ffff:ffff:ffff:ffff
denied-peer-ip=fe80::-febf:ffff:ffff:ffff:ffff:ffff:ffff:ffff
log-file=stdout
simple-log
