# Export this variable separately before running Alembic.
SERVICE_DATABASE_URL=postgresql+psycopg://tenant:local-demo-only@127.0.0.1:55409/telelink
SERVICE_ENVIRONMENT=local
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8002
# Ingress strips /api/v1/tenant; direct routes start at /clinics.
SERVICE_ROOT_PATH=
SERVICE_IDENTITY_URL=http://127.0.0.1:8001
# Set all three to the actual local Cognito pool/public app client.
# SERVICE_AUTH_ISSUER=http://localhost:4566/ACTUAL_POOL_ID
# SERVICE_AUTH_JWKS_URL=http://localhost:4566/ACTUAL_POOL_ID/.well-known/jwks.json
# SERVICE_AUTH_CLIENT_ID=ACTUAL_PUBLIC_CLIENT_ID
SERVICE_AUTH_REQUIRED_SCOPES=openid
# DIFFERENT random secrets, each at least 32 bytes. Keep them out of Git.
# SERVICE_CURSOR_SECRET=REPLACE_WITH_RANDOM_SECRET
# Same tenant secret on identity and tenant services, for creator provisioning only.
# SERVICE_TENANT_SECRET=REPLACE_WITH_RANDOM_TENANT_SECRET
# A10: same identity secret on identity and tenant, for clinic validation only.
# SERVICE_IDENTITY_SECRET=REPLACE_WITH_RANDOM_IDENTITY_SECRET
# Same booking secret on scheduling and tenant; distinct from identity access key.
# SERVICE_SCHEDULING_SECRET=REPLACE_WITH_RANDOM_BOOKING_SECRET
SERVICE_CORS_ORIGINS=[]
# Optional managed logo storage. Use a separate, unversioned branding bucket.
# SERVICE_LOGO_BUCKET=telelink-local-branding
# Production public HTTPS CloudFront asset base; local previews read via tenant API.
# SERVICE_LOGO_PUBLIC_BASE_URL=https://assets.example.com
SERVICE_LOGO_REGION=ap-southeast-1
# Local/test only; remove for AWS. Emulator always uses dummy credentials.
# SERVICE_LOGO_S3_ENDPOINT=http://localhost:4566
