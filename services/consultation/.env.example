SERVICE_DATABASE_URL=postgresql+psycopg://consultation:local-demo-only@localhost:5432/telelink
SERVICE_ENVIRONMENT=local
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8004
# Direct service routes omit /api/v1/consultation; a later proxy strips that prefix.
SERVICE_ROOT_PATH=
# Configure all three from local Cognito bootstrap; no token/header bypass.
# SERVICE_AUTH_ISSUER=http://localhost:4566/ACTUAL_POOL_ID
# SERVICE_AUTH_JWKS_URL=http://localhost:4566/ACTUAL_POOL_ID/.well-known/jwks.json
# SERVICE_AUTH_CLIENT_ID=ACTUAL_PUBLIC_CLIENT_ID
SERVICE_AUTH_REQUIRED_SCOPES=openid
SERVICE_IDENTITY_URL=http://127.0.0.1:8001
SERVICE_SCHEDULING_URL=http://127.0.0.1:8003
SERVICE_BILLING_URL=http://127.0.0.1:8009
# Four DIFFERENT random secrets, each at least 32 bytes; never commit real values.
# Match identity's SERVICE_CONSULTATION_SECRET:
# SERVICE_IDENTITY_SECRET=REPLACE_WITH_RANDOM_IDENTITY_SECRET
# Match scheduling's SERVICE_CONSULTATION_SECRET:
# SERVICE_SCHEDULING_SECRET=REPLACE_WITH_RANDOM_SCHEDULING_SECRET
# Match billing's SERVICE_CONSULTATION_SECRET:
# SERVICE_BILLING_SECRET=REPLACE_WITH_RANDOM_BILLING_SECRET
# Used only by the signalling consumer with sub=signalling:
# SERVICE_SIGNALLING_SECRET=REPLACE_WITH_RANDOM_SIGNALLING_SECRET
SERVICE_ADMISSION_TTL_SECONDS=60
SERVICE_UPSTREAM_TIMEOUT_SECONDS=3
