SERVICE_NAME=fulfilment
SERVICE_ENVIRONMENT=local
SERVICE_PORT=8006
SERVICE_ROOT_PATH=/api/v1/fulfilment
SERVICE_DATABASE_URL=postgresql+psycopg://fulfilment:local-demo-only@localhost:5432/telelink
SERVICE_IDENTITY_URL=http://localhost:8001
# Set the same issuer/JWKS/client used by the existing local Cognito setup.
# SERVICE_AUTH_ISSUER=http://localhost:4566/<pool-id>
# SERVICE_AUTH_JWKS_URL=http://localhost:4566/<pool-id>/.well-known/jwks.json
# SERVICE_AUTH_CLIENT_ID=<local-spa-client-id>
# Generate a private, stable value of at least 32 bytes. No built-in default.
# SERVICE_CURSOR_SECRET=<random-private-secret>
# Opt-in local/test synthetic C04 projection, resolved from this service directory:
# SERVICE_DISPENSING_FIXTURE_PATH=../../contracts/examples/prescription-order-quote.json

# D02 application adapter; see QUOTES.md for the private locations JSON format.
# SERVICE_LALAMOVE_API_KEY=pk_test_REPLACE_LOCALLY
# SERVICE_LALAMOVE_API_SECRET=sk_test_REPLACE_LOCALLY
# SERVICE_DELIVERY_LOCATIONS_PATH=<private-absolute-path-to-locations.json>

# D04 separate payment consumer process; see PAYMENTS.md.
# SERVICE_BILLING_URL=http://localhost:8009
# Match billing SERVICE_FULFILMENT_SECRET; use a private value of at least 32 bytes.
# SERVICE_BILLING_SECRET=<distinct-private-service-secret>
SERVICE_PAYMENT_QUEUE_NAME=telelink-local-fulfilment
# SERVICE_AWS_ENDPOINT_URL=http://localhost:4566
# Local emulator only: AWS_ACCESS_KEY_ID=test and AWS_SECRET_ACCESS_KEY=test.

# X05 isolated sandbox CLI only (not application delivery integration).
LALAMOVE_API_KEY=
LALAMOVE_API_SECRET=
LALAMOVE_MARKET=SG
LALAMOVE_BASE_URL=https://rest.sandbox.lalamove.com
