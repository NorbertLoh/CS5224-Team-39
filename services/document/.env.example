# Export this variable before running Alembic; it does not load .env files.
SERVICE_DATABASE_URL=postgresql+psycopg://document:local-demo-only@localhost:5432/telelink
SERVICE_ENVIRONMENT=local
# The records API includes this prefix even when called directly.
SERVICE_RECORDS_URL=http://127.0.0.1:8005/api/v1/clinical-records
# Match clinical-records SERVICE_DOCUMENT_SECRET; use an independent random 32+ byte key.
# SERVICE_RECORDS_SECRET=
SERVICE_DOCUMENT_BUCKET=telelink-local-documents
SERVICE_DOCUMENT_QUEUE_NAME=telelink-local-document
SERVICE_AWS_REGION=ap-southeast-1
SERVICE_EVENT_BUS_NAME=telelink-local
# Local Floci only; omit for AWS.
SERVICE_AWS_ENDPOINT_URL=http://localhost:4566

# P03 API (direct roots, without frontend API prefixes).
SERVICE_IDENTITY_URL=http://127.0.0.1:8001
SERVICE_SCHEDULING_URL=http://127.0.0.1:8003
# Match your Floci pool/client; all three auth values must be supplied together.
# SERVICE_AUTH_ISSUER=http://localhost:4566/<pool-id>
# SERVICE_AUTH_JWKS_URL=http://localhost:4566/<pool-id>/.well-known/jwks.json
# SERVICE_AUTH_CLIENT_ID=<public-client-id>
# Independent random secret, at least 32 bytes, different from records_secret.
# SERVICE_CURSOR_SECRET=
SERVICE_DOWNLOAD_TTL_SECONDS=120
# Browser endpoint used directly when signing. Omit alongside AWS_ENDPOINT_URL on AWS.
SERVICE_S3_BROWSER_ENDPOINT_URL=http://localhost:4566

# N02: independent random 32+ byte key matching notification SERVICE_DOCUMENT_SECRET.
# SERVICE_NOTIFICATION_SECRET=
