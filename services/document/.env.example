# Export this variable before running Alembic; it does not load .env files.
SERVICE_DATABASE_URL=postgresql+psycopg://document:local-demo-only@localhost:5432/telelink
SERVICE_ENVIRONMENT=local
# The records API includes this prefix even when called directly.
SERVICE_RECORDS_URL=http://127.0.0.1:8005/api/v1/clinical-records
# Match clinical-records SERVICE_DOCUMENT_SECRET; use an independent random 32+ byte key.
# SERVICE_RECORDS_SECRET=
SERVICE_DOCUMENT_BUCKET=telelink-local-documents
SERVICE_DOCUMENT_QUEUE_NAME=telelink-local-document
SERVICE_AWS_REGION=ap-southeast-1
SERVICE_EVENT_BUS_NAME=telelink-local
# Local Floci only; omit for AWS.
SERVICE_AWS_ENDPOINT_URL=http://localhost:4566
