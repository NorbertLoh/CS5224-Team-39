# Synthetic LOCAL values only; never reuse for AWS/production.
COMPOSE_PROJECT_NAME=telelink
TEMPLATE_HOST_PORT=8000

# Keep PostgreSQL 17's data layout; major upgrades need a data migration.
POSTGRES_IMAGE=postgres:17
POSTGRES_DB=telelink
POSTGRES_USER=postgres
POSTGRES_PASSWORD=telelink-local-only
POSTGRES_PORT=55432

REDIS_IMAGE=redis:7.4-alpine
REDIS_PORT=6379

# Initial release choice; F16 validates required operations and persistence.
FLOCI_IMAGE=floci/floci:2.2.0
FLOCI_PORT=4566

# Reserved for the A01/A02 frontend auth routes; exact URL matching is required.
COGNITO_CALLBACK_URL=http://localhost:5173/auth/callback
COGNITO_LOGOUT_URL=http://localhost:5173/

# Dummy local SDK/CLI values. Compose does not export them to host shells.
AWS_DEFAULT_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
