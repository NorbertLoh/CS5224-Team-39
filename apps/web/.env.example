# Public build-time API base; use a trusted origin and never place secrets here.
VITE_API_BASE_URL=/api/v1

# Vite server only. Match TEMPLATE_HOST_PORT in the root .env if changed.
TEMPLATE_API_TARGET=http://127.0.0.1:8000

# Copy pool/client IDs from the Cognito bootstrap output. No client secret.
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_ISSUER=http://localhost:4566/REPLACE_WITH_POOL_ID
VITE_COGNITO_OAUTH_BASE_URL=http://localhost:4566/cognito-idp
VITE_COGNITO_API_URL=http://localhost:4566/
