# Both environments use real APIs. Restart Vite after changing configuration.
VITE_USE_AWS=false
VITE_LOCAL_API_BASE_URL=/api/v1
# Required when VITE_USE_AWS=true; use the deployed HTTPS API gateway URL.
VITE_AWS_API_BASE_URL=

# Local Vite proxy targets (server only).
IDENTITY_API_TARGET=http://127.0.0.1:8001
TENANT_API_TARGET=http://127.0.0.1:8002
BILLING_API_TARGET=http://127.0.0.1:8009
SCHEDULING_API_TARGET=http://127.0.0.1:8003
CONSULTATION_API_TARGET=http://127.0.0.1:8004
RECORDS_API_TARGET=http://127.0.0.1:8005
DOCUMENT_API_TARGET=http://127.0.0.1:8007
FULFILMENT_API_TARGET=http://127.0.0.1:8006
TEMPLATE_API_TARGET=http://127.0.0.1:8000

# Local Cognito / Floci public client. No client secret.
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_ISSUER=http://localhost:4566/REPLACE_WITH_POOL_ID
VITE_COGNITO_OAUTH_BASE_URL=http://localhost:4566/cognito-idp
VITE_COGNITO_API_URL=http://localhost:4566/

# Required when VITE_USE_AWS=true. Use actual deployed AWS values.
VITE_AWS_COGNITO_CLIENT_ID=
VITE_AWS_COGNITO_ISSUER=
VITE_AWS_COGNITO_OAUTH_BASE_URL=
VITE_AWS_COGNITO_API_URL=
