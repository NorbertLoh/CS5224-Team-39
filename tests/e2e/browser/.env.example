# Copy to .env in this directory. Never commit credentials or reports.
E2E_TARGET=local
E2E_BASE_URL=https://localhost:8443
E2E_API_PATH=/api/v1
# Enable only for a local self-signed certificate; forbidden for aws-staging.
E2E_IGNORE_HTTPS_ERRORS=true

E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
E2E_DOCTOR_EMAIL=
E2E_DOCTOR_PASSWORD=
E2E_CLINIC_ADMIN_EMAIL=
E2E_CLINIC_ADMIN_PASSWORD=
E2E_PLATFORM_ADMIN_EMAIL=
E2E_PLATFORM_ADMIN_PASSWORD=
# Existing active dedicated test clinic. Doctor must already be verified/assigned.
E2E_CLINIC_SLUG=

# Booking/Stripe suites create a slot and booking using real APIs/UI.
E2E_ALLOW_WRITES=false
# Required for hosted test Checkout; also requires a headed browser.
E2E_STRIPE_TEST_MODE=false
E2E_PAYMENT_WAIT_SECONDS=480

# Optional evidence suite: required when explicitly running test:evidence.
# These IDs must refer to one genuine completed synthetic journey for this patient.
E2E_APPOINTMENT_ID=
E2E_ORDER_ID=
# submitted | picked_up | delivered | cancelled | failed
E2E_EXPECT_DELIVERY_STATUS=submitted
